<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="780"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="640"
        x:Class="MétéoWither.MainWindow"
        Background="#E3EFF2"
        Title="MétéoWither">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#102A33" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#8FB0BA" />
            <Setter Property="CaretBrush" Value="#102A33" />
            <Setter Property="SelectionBrush" Value="#B9DCE3" />
            <Setter Property="SelectionForegroundBrush" Value="#102A33" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Foreground" Value="#102A33" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0F6B78" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="#102A33" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0F6B78" />
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#8FB0BA" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0F6B78" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0F6B78" />
        </Style>
        <Style Selector="Button.primaryAction">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#0F6B78" />
            <Setter Property="BorderBrush" Value="#0A5560" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.primaryAction:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#0B5D68" />
            <Setter Property="BorderBrush" Value="#083F47" />
        </Style>
        <Style Selector="Button.primaryAction:pressed">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#084A54" />
            <Setter Property="BorderBrush" Value="#063942" />
        </Style>
        <Style Selector="Button.primaryAction:disabled">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#56737B" />
            <Setter Property="BorderBrush" Value="#405A61" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#102A33" />
            <Setter Property="Background" Value="#F3FAFC" />
            <Setter Property="BorderBrush" Value="#8FB0BA" />
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="Foreground" Value="#102A33" />
            <Setter Property="Background" Value="#E6F4F7" />
            <Setter Property="BorderBrush" Value="#0F6B78" />
        </Style>
        <Style Selector="ComboBox:pressed">
            <Setter Property="Foreground" Value="#102A33" />
            <Setter Property="Background" Value="#D8EEF3" />
            <Setter Property="BorderBrush" Value="#084A54" />
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="Foreground" Value="#102A33" />
            <Setter Property="Background" Value="#E6F4F7" />
            <Setter Property="BorderBrush" Value="#0F6B78" />
        </Style>
        <Style Selector="ComboBox:dropdownopen">
            <Setter Property="Foreground" Value="#102A33" />
            <Setter Property="Background" Value="#D8EEF3" />
            <Setter Property="BorderBrush" Value="#084A54" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="#F3FAFC" />
            <Setter Property="BorderBrush" Value="#8FB0BA" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#E6F4F7" />
            <Setter Property="BorderBrush" Value="#0F6B78" />
        </Style>
        <Style Selector="ComboBox:pressed /template/ Border#Background">
            <Setter Property="Background" Value="#D8EEF3" />
            <Setter Property="BorderBrush" Value="#084A54" />
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="Background" Value="#E6F4F7" />
            <Setter Property="BorderBrush" Value="#0F6B78" />
        </Style>
        <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
            <Setter Property="Background" Value="#D8EEF3" />
            <Setter Property="BorderBrush" Value="#084A54" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Margin="26" RowSpacing="18">
        <Border Padding="24,20"
                CornerRadius="22"
                Background="#FFFFFF"
                BorderBrush="#AFC8D1"
                BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="5">
                    <TextBlock Text="MétéoWither"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="#102A33" />
                    <TextBlock Text="Recherche météo, prévisions à 12:00 et préférences enregistrées."
                               FontSize="15"
                               Foreground="#2D4A53" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="16,10"
                        CornerRadius="16"
                        Background="#D9EFE2"
                        BorderBrush="#8DBA9D"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderSummaryTextBlock"
                               Text="Initialisation..."
                               Foreground="#1E3A2E"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Recherche">
                <ScrollViewer>
                    <Grid Margin="0,18,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox x:Name="SearchCityTextBox"
                                     PlaceholderText="Exemple : Paris"
                                     KeyDown="OnSearchCityKeyDown" />
                            <Button x:Name="SearchButton"
                                    Classes="primaryAction"
                                    Grid.Column="1"
                                    Content="Rechercher"
                                    Click="OnSearchWeatherClick" />
                        </Grid>

                        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <TextBlock x:Name="SearchStatusTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#2D4A53" />
                            <ProgressBar x:Name="SearchProgressBar"
                                         Grid.Row="1"
                                         Height="4"
                                         IsIndeterminate="True"
                                         IsVisible="False" />
                        </Grid>

                        <Border Grid.Row="2"
                                Padding="24"
                                CornerRadius="22"
                                BorderThickness="1"
                                BorderBrush="#AFC8D1"
                                Background="#FFFFFF">
                            <Grid ColumnDefinitions="180,*" ColumnSpacing="26">
                                <Border Width="180"
                                        Height="180"
                                        CornerRadius="26"
                                        Background="#DDEBFF"
                                        BorderBrush="#9FBDE4"
                                        BorderThickness="1">
                                    <Image x:Name="CurrentWeatherImage"
                                           Margin="22"
                                           Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock x:Name="CurrentCityTextBlock"
                                               Text="Aucune recherche"
                                               FontSize="31"
                                               FontWeight="SemiBold"
                                               Foreground="#102A33"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="CoordinatesTextBlock"
                                               Text="Latitude / Longitude : -"
                                               FontSize="15"
                                               Foreground="#2D4A53" />

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="8">
                                        <TextBlock x:Name="TemperatureTextBlock"
                                                   Text="Température : -"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0A5667" />
                                        <TextBlock x:Name="HumidityTextBlock"
                                                   Grid.Column="1"
                                                   Text="Humidité : -"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Foreground="#3E5C25" />
                                        <TextBlock x:Name="DescriptionTextBlock"
                                                   Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="Description : -"
                                                   FontSize="17"
                                                   Foreground="#1F3A43"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Prévisions">
                <ScrollViewer>
                    <Grid Margin="0,18,0,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox x:Name="ForecastCityTextBox"
                                     PlaceholderText="Exemple : Lyon"
                                     KeyDown="OnForecastCityKeyDown" />
                            <Button x:Name="ForecastButton"
                                    Classes="primaryAction"
                                    Grid.Column="1"
                                    Content="Charger 5 jours"
                                    Click="OnSearchForecastClick" />
                        </Grid>

                        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <TextBlock x:Name="ForecastStatusTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#2D4A53" />
                            <ProgressBar x:Name="ForecastProgressBar"
                                         Grid.Row="1"
                                         Height="4"
                                         IsIndeterminate="True"
                                         IsVisible="False" />
                        </Grid>

                        <TextBlock x:Name="ForecastCitySummaryTextBlock"
                                   Grid.Row="2"
                                   Text="Les prévisions apparaîtront ici."
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#102A33" />

                        <Grid x:Name="ForecastCardsGrid"
                              Grid.Row="3"
                              ColumnDefinitions="*,*,*,*,*"
                              ColumnSpacing="12" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Paramètres">
                <ScrollViewer>
                    <Grid Margin="0,18,0,0" ColumnDefinitions="2*,*" ColumnSpacing="18">
                        <Border Padding="24"
                                CornerRadius="22"
                                BorderThickness="1"
                                BorderBrush="#AFC8D1"
                                Background="#FFFFFF">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Ville par défaut"
                                           FontWeight="SemiBold"
                                           Foreground="#102A33" />
                                <TextBox x:Name="DefaultCityTextBox"
                                         PlaceholderText="Ville remplie au démarrage" />

                                <TextBlock Text="Langue des requêtes"
                                           FontWeight="SemiBold"
                                           Foreground="#102A33" />
                                <ComboBox x:Name="LanguageComboBox"
                                          SelectedIndex="0"
                                          MaxDropDownHeight="260">
                                    <ComboBoxItem Content="Français" />
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="Español" />
                                    <ComboBoxItem Content="Italiano" />
                                    <ComboBoxItem Content="Deutsch" />
                                    <ComboBoxItem Content="Português" />
                                    <ComboBoxItem Content="Nederlands" />
                                    <ComboBoxItem Content="Polski" />
                                </ComboBox>

                                <Button x:Name="SaveOptionsButton"
                                        Classes="primaryAction"
                                        HorizontalAlignment="Left"
                                        Content="Enregistrer"
                                        Click="OnSaveOptionsClick" />

                                <TextBlock x:Name="SettingsStatusTextBlock"
                                           TextWrapping="Wrap"
                                           Foreground="#2D4A53" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Padding="24"
                                CornerRadius="22"
                                BorderThickness="1"
                                BorderBrush="#AFC8D1"
                                Background="#F5FBF4">
                            <StackPanel Spacing="12">
                                <TextBlock Text="État de l'application"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#102A33" />
                                <TextBlock x:Name="ApiKeyStatusTextBlock"
                                           Text="Clé API : vérification..."
                                           TextWrapping="Wrap"
                                           Foreground="#2D4A53" />
                                <TextBlock x:Name="OptionsPathTextBlock"
                                           TextWrapping="Wrap"
                                           Foreground="#2D4A53" />
                                <TextBlock x:Name="ConfigPathTextBlock"
                                           TextWrapping="Wrap"
                                           Foreground="#2D4A53" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
