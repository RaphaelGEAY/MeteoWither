<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="760"
        Width="1100"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        x:Class="MétéoWither.MainWindow"
        Title="MétéoWither">
    <Grid Margin="24" RowDefinitions="Auto,*">
        <StackPanel Spacing="4">
            <TextBlock Text="MétéoWither"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="Base minimale pour la recherche météo, les prévisions et les paramètres."
                       Opacity="0.72" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,20,0,0">
            <TabItem Header="Recherche">
                <ScrollViewer>
                    <StackPanel Margin="0,16,0,16" Spacing="16">
                        <TextBlock Text="Ville à rechercher"
                                   FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox x:Name="SearchCityTextBox"
                                     PlaceholderText="Exemple : Paris" />
                            <Button Grid.Column="1"
                                    Content="Rechercher"
                                    Click="OnSearchWeatherClick" />
                        </Grid>

                        <TextBlock x:Name="SearchStatusTextBlock"
                                   TextWrapping="Wrap" />

                        <Border Padding="20"
                                CornerRadius="16"
                                BorderThickness="1"
                                BorderBrush="#D7E3F4"
                                Background="#F8FAFC">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="CurrentCityTextBlock"
                                           Text="Aucune recherche"
                                           FontSize="24"
                                           FontWeight="SemiBold" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                                    <Border Width="110"
                                            Height="110"
                                            CornerRadius="14"
                                            Background="#E2E8F0">
                                        <Image x:Name="CurrentWeatherImage"
                                               Margin="12"
                                               Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="CoordinatesTextBlock"
                                                   Text="Latitude / Longitude : -" />
                                        <TextBlock x:Name="TemperatureTextBlock"
                                                   Text="Température : -" />
                                        <TextBlock x:Name="DescriptionTextBlock"
                                                   Text="Description : -" />
                                        <TextBlock x:Name="HumidityTextBlock"
                                                   Text="Humidité : -" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Prévisions">
                <ScrollViewer>
                    <StackPanel Margin="0,16,0,16" Spacing="16">
                        <TextBlock Text="Ville pour les prévisions"
                                   FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox x:Name="ForecastCityTextBox"
                                     PlaceholderText="Exemple : Lyon" />
                            <Button Grid.Column="1"
                                    Content="Charger 5 jours"
                                    Click="OnSearchForecastClick" />
                        </Grid>

                        <TextBlock x:Name="ForecastStatusTextBlock"
                                   TextWrapping="Wrap" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ForecastCardsPanel"
                                        Orientation="Horizontal"
                                        Spacing="12" />
                        </ScrollViewer>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Paramètres">
                <ScrollViewer>
                    <StackPanel Margin="0,16,0,16" Spacing="16">
                        <TextBlock Text="Ville par défaut"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="DefaultCityTextBox"
                                 PlaceholderText="Ville remplie au démarrage" />

                        <TextBlock Text="Langue des requêtes"
                                   FontWeight="SemiBold" />
                        <ComboBox x:Name="LanguageComboBox"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Français" />
                            <ComboBoxItem Content="English" />
                            <ComboBoxItem Content="Español" />
                            <ComboBoxItem Content="Italiano" />
                            <ComboBoxItem Content="Deutsch" />
                        </ComboBox>

                        <Button HorizontalAlignment="Left"
                                Content="Enregistrer"
                                Click="OnSaveOptionsClick" />

                        <TextBlock x:Name="SettingsStatusTextBlock"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
